{
  "name": "xiezhi-audit",
  "version": "0.1.0-alpha",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" run build",
    "typecheck": "pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" run typecheck",
    "lint": "eslint . && node scripts/skills-history.mjs --check",
    "test": "node --test --test-timeout=60000 \"packages/*/test/*.test.mjs\"",
    "cli": "node apps/cli/dist/main.js",
    "eval": "node apps/cli/dist/main.js eval",
    "release:pack": "pnpm build && node scripts/build-release.mjs && cd release/xiezhi-audit && npm pack --pack-destination .."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.20.4",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
