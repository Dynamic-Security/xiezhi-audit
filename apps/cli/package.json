    "@xiezhi/eval": "workspace:*",
    "@xiezhi/knowledge": "workspace:*",
    "@xiezhi/report": "workspace:*",
    "@xiezhi/server": "workspace:*",
    "@xiezhi/store": "workspace:*"
  },
  "bin": {
    "xiezhi": "./dist/main.js"
  }
}
